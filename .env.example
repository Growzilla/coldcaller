# RapidDial — copy to .env.local and fill in ONE telephony provider.
#   cp .env.example .env.local

# ── Provider: 46elks (Sweden) | twilio (global) | vonage ───────────────────────────────
DIALER_PROVIDER=twilio

# ── Twilio — console.twilio.com ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Voice-capable Twilio numbers (E.164). The cockpit toggle picks Australia or Canada.
# The Australia side dials Australia leads. The Canada side dials Canada leads.
TWILIO_AUSTRALIA_NUMBER=
TWILIO_CANADA_NUMBER=
# Legacy single number, used only when the two above are empty.
# TWILIO_NUMBER=
# Browser line (no phone needed): Console → Account → API keys → create Standard key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_CLIENT_IDENTITY=rapiddial-operator

# ── 46elks — 46elks.se → Account / Numbers ─────────────────────────────────────────────
# 46ELKS_API_USERNAME=
# 46ELKS_API_PASSWORD=
# 46ELKS_NUMBER=+46...
# 46ELKS_NUMBER_ID=n...
# Browser line: `npm run elks:webrtc -- --allocate` finds/creates the WebRTC number
# 46ELKS_WEBRTC_SECRET=

# ── Vonage (legacy) — `npm run setup` writes VONAGE_APPLICATION_ID ─────────────────────
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_NUMBER=+...

# ── You ────────────────────────────────────────────────────────────────────────────────
# Your mobile (E.164) — only needed for phone mode (it rings first, then bridges each lead)
OPERATOR_PHONE=
# Protects the app when it's reachable from the internet (tunnel/Render). Unset = no auth.
# DIALER_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────────────────────────
# Call transcripts + AI summaries (OpenRouter)
# OPENROUTER_API_KEY=
# "Send booking link" email (Resend) + Calendly booked-detection
# RESEND_API_KEY=
# BOOKING_URL=https://calendly.com/you/demo
# BOOKING_FROM=You <you@yourdomain.com>
# CALENDLY_TOKEN=
# GoHighLevel as the lead master (see README → GoHighLevel sync)
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# GHL_USER_ID=
# GHL_PIPELINE_NAME=Outbound

# ── SMS campaigns (/sms) ───────────────────────────────────────────────────────────────
# Uses the 46elks number above. Leave the password empty for localhost-only use.
# SMS_APP_PASSWORD=
# Your mobile. Positive replies and inbound VOIP calls text this number.
# SMS_NOTIFY_NUMBER=+46...
# Account ceiling. Campaigns cannot exceed this, and nothing can exceed SMS_HARD_DAILY_CAP (default 100, max 200).
# SMS_DAILY_LIMIT=50
# SMS_WINDOW_START=09:00
# SMS_WINDOW_END=17:00
# Minimum 45. Default 90.
# SMS_MIN_GAP_SECONDS=90
# SMS_WEEKDAYS_ONLY=1
# Public origin used in alert links and the 46elks delivery webhook. localhost skips delivery webhooks.
# SMS_PUBLIC_URL=http://localhost:3100
# SMS_WORKER_INTERVAL_MS=30000
