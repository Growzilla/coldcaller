# RapidDial — copy to .env.local and fill in ONE telephony provider.
#   cp .env.example .env.local

# ── Provider: 46elks (Sweden) | twilio (global) | vonage ───────────────────────────────
DIALER_PROVIDER=twilio

# ── Twilio — console.twilio.com ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A voice-capable Twilio number you own (E.164) — the caller ID leads see
TWILIO_NUMBER=
# Browser line (no phone needed): Console → Account → API keys → create Standard key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_CLIENT_IDENTITY=rapiddial-operator

# ── 46elks — 46elks.se → Account / Numbers ─────────────────────────────────────────────
# 46ELKS_API_USERNAME=
# 46ELKS_API_PASSWORD=
# 46ELKS_NUMBER=+46...
# 46ELKS_NUMBER_ID=n...
# Browser line: `npm run elks:webrtc -- --allocate` finds/creates the WebRTC number
# 46ELKS_WEBRTC_SECRET=

# ── Vonage (legacy) — `npm run setup` writes VONAGE_APPLICATION_ID ─────────────────────
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_NUMBER=+...

# ── You ────────────────────────────────────────────────────────────────────────────────
# Your mobile (E.164) — only needed for phone mode (it rings first, then bridges each lead)
OPERATOR_PHONE=
# Protects the app when it's reachable from the internet (tunnel/Render). Unset = no auth.
# DIALER_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────────────────────────
# Call transcripts + AI summaries (OpenRouter)
# OPENROUTER_API_KEY=
# "Send booking link" email (Resend) + Calendly booked-detection
# RESEND_API_KEY=
# BOOKING_URL=https://calendly.com/you/demo
# BOOKING_FROM=You <you@yourdomain.com>
# CALENDLY_TOKEN=
# GoHighLevel as the lead master (see README → GoHighLevel sync)
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# GHL_USER_ID=
# GHL_PIPELINE_NAME=Outbound
